<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NdiRouter.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <!-- Section headings -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="ListBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#FF8A65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Form labels -->
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Compact rows in the log -->
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Tabs: Fluent's default headers are display-sized -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- A grouped panel of settings -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,8,16,16" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Router panel buttons -->
    <Style Selector="Panel.tile">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Panel.tile Border.hover">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Panel.tile:pointerover Border.hover">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Table rows: tighter text boxes -->
    <Style Selector="Grid.row TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Grid.row AutoCompleteBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Application.Styles>
</Application>
